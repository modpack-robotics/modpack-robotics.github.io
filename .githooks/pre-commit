#!/bin/sh
# Anonymity guard: block any commit whose author/committer identity is not anonymous.
# This repo is a double-blind conference submission; commits must never carry a real
# name or email. See README / project notes.

EXPECTED_EMAIL="anonymous@example.com"
EXPECTED_NAME="Anonymous"

a_name=$(git config user.name)
a_email=$(git config user.email)

fail=0
if [ "$a_email" != "$EXPECTED_EMAIL" ]; then
  echo "BLOCKED: author email is '$a_email', expected '$EXPECTED_EMAIL'." >&2
  fail=1
fi
if [ "$a_name" != "$EXPECTED_NAME" ]; then
  echo "BLOCKED: author name is '$a_name', expected '$EXPECTED_NAME'." >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "This repo is anonymous. Fix with:" >&2
  echo "  git config --local user.name  \"$EXPECTED_NAME\"" >&2
  echo "  git config --local user.email \"$EXPECTED_EMAIL\"" >&2
  exit 1
fi

exit 0
